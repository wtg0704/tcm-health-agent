# ====== HuggingFace缓存（可选，不设置则默认写C盘）======
HF_HOME=./.hf_cache
HF_ENDPOINT=https://hf-mirror.com

# ====== LLM配置 ======
# 支持 deepseek / ollama
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Ollama（本地部署备用）
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ====== 多模态 + Rerank（DashScope 兼容模式）======
# 用于舌诊/体检报告图片解析（qwen3.8-omni-flash）与检索精排（qwen3-rerank）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ====== 数据库 ======
# 本地开发用SQLite，生产部署用PostgreSQL
DATABASE_URL=sqlite:///./tcm_health.db

# ====== Chroma ======
CHROMA_HOST=localhost
CHROMA_PORT=8000
